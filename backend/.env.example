# Campus AI Environment Variables

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Set either GEMINI_API_KEY or OPENAI_API_KEY.
# If left empty, Campus AI uses its built-in local RAG retriever and answer synthesis engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# OCR Configuration (Optional - Windows native OCR winocr is automatically used on Windows)
TESSERACT_CMD=

# Server Configuration
HOST=127.0.0.1
PORT=8000
